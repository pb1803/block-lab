# Arkiv POC environment (copy to `.env.local`, which is git-ignored).
#
# Never commit this file with values, never paste a real key into chat or logs.

# Optional Arkiv RPC access key (raises the public RPC rate limit).
# It is NOT a signing key and never signs anything. Leave unset to use the
# public Rabdi endpoint, which is heavily rate limited (HTTP 429
# ANON_COST_LIMITED once the anonymous query budget is spent).
# Browser build reads VITE_ARKIV_ACCESS_KEY; the write harness reads
# ARKIV_ACCESS_KEY (or VITE_ARKIV_ACCESS_KEY as a fallback).
# Get one at https://hub.arkiv.network/access-keys
VITE_ARKIV_ACCESS_KEY=
ARKIV_ACCESS_KEY=

# Dedicated Rabdi testnet signer for the headless write harness ONLY.
# The browser POC never reads this: it signs through the user's wallet.
# Generate one locally, keep it in `.env.local`, and fund its ADDRESS at
# https://hub.arkiv.network/faucet. Run the harness with
#   pnpm --filter @blocklab/arkiv-poc exec node --env-file=.env.local scripts/try-write.mjs
ARKIV_PRIVATE_KEY=
