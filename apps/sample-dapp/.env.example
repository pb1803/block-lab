# Destination for both routes (direct fetch and the Anon-RPC worker).
# For the local Anvil workflow use http://127.0.0.1:8545.
VITE_RPC_URL=http://127.0.0.1:8545

# Endpoint used only to read the on-chain worker specifier.
# Defaults to VITE_RPC_URL when omitted, which is correct for the official
# passthrough worker; tor-js/nym need a mainnet endpoint and nox needs Sepolia.
# VITE_ANON_RPC_BOOTSTRAP_RPC_URL=https://ethereum-rpc.publicnode.com

# One of: passthrough | tor-js | nym | nox
# passthrough is a reference worker and is NOT anonymizing.
VITE_ANON_RPC_WORKER=passthrough
