{
  "name": "@blocklab/studio",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./comparison": "./dist/comparison/index.js",
    "./arkiv": "./dist/arkiv/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "preflight:test": "node --env-file=../arkiv-poc/.env.local scripts/studio-arkiv-preflight.mjs",
    "probe:ark06": "node --env-file=../arkiv-poc/.env.local scripts/arkiv-06-probe.mjs",
    "probe:ark06:live": "node --env-file=../arkiv-poc/.env.local scripts/arkiv-06-probe.mjs --live",
    "preview": "vite preview",
    "record:ark05": "node scripts/studio-mm-002-record.mjs",
    "record:test": "node scripts/studio-mm-test-record.mjs",
    "verify:entity": "node --env-file=../arkiv-poc/.env.local scripts/verify-entity.mjs",
    "verify:live": "node --env-file=../arkiv-poc/.env.local scripts/studio-arkiv-live.mjs"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@blocklab/arkiv-metadata": "workspace:*",
    "@blocklab/browser-rpc": "workspace:*",
    "@blocklab/core": "workspace:*",
    "viem": "2.57.16"
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
