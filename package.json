{
  "name": "blocklab",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "verify:browser": "node scripts/browser-selftest.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
